  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2"
  }
}
